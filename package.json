{
  "name": "kadhiri-ai-grievance-kiosk",
  "version": "1.0.0",
  "description": "Kadhiri AI Public Grievance Kiosk - unattended audio-complaint recording kiosk",
  "author": "Kadhiri District Administration <admin@kadhiri.gov.in>",
  "license": "UNLICENSED",
  "private": true,
  "main": "dist-electron/main/index.js",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && npm run build:electron && vite build",
    "build:renderer": "vite build",
    "build:electron": "tsc -p electron/tsconfig.json && node scripts/mark-commonjs.cjs",
    "preview": "vite preview",
    "electron:dev": "concurrently -k \"cross-env NODE_ENV=development vite\" \"npm:electron:watch\"",
    "electron:watch": "node scripts/mark-commonjs.cjs && tsc -p electron/tsconfig.json --watch --preserveWatchOutput",
    "electron:start": "wait-on tcp:5173 file:dist-electron/main/index.js && cross-env NODE_ENV=development electron .",
    "start": "cross-env NODE_ENV=development concurrently -k \"npm:dev\" \"npm:electron:watch\" \"npm:electron:start\"",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p electron/tsconfig.json --noEmit",
    "lint": "eslint . --ext .ts,.tsx",
    "package": "npm run build && electron-builder --linux",
    "package:arm64": "npm run build && electron-builder --linux AppImage --arm64"
  },
  "dependencies": {
    "axios": "^1.7.9",
    "form-data": "^4.0.1",
    "framer-motion": "^11.15.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.1.1",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@typescript-eslint/eslint-plugin": "^8.19.0",
    "@typescript-eslint/parser": "^8.19.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "eslint": "^9.17.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vite": "^6.0.6",
    "wait-on": "^8.0.1"
  }
}
