# ============================================================
# Frontend — Electron + Vite + React + TypeScript .gitignore
# ============================================================

# ── Node / npm ───────────────────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/
*.tgz
package-lock.json.bak

# ── Build outputs ────────────────────────────────────────────
dist/
dist-electron/
build/
out/
release/
.output/

# ── Vite ─────────────────────────────────────────────────────
.vite/
vite.config.ts.timestamp-*

# ── Electron Builder ─────────────────────────────────────────
# Packaged installers / executables — large binary artefacts
*.AppImage
*.deb
*.rpm
*.exe
*.dmg
*.zip
*.tar.gz
*.snap
*.flatpak

# ── TypeScript ───────────────────────────────────────────────
*.tsbuildinfo
tsconfig.tsbuildinfo

# ── Environment / secrets — NEVER commit ────────────────────
.env
.env.*
!.env.example
config.local.json

# ── Test artefacts ───────────────────────────────────────────
coverage/
.nyc_output/
*.lcov
test-results/
playwright-report/
.playwright/

# ── ESLint / Prettier cache ──────────────────────────────────
.eslintcache
.stylelintcache
.prettiercache

# ── OS / Editor artefacts ────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
*.swp
*.swo
*~
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj

# ── Logs ─────────────────────────────────────────────────────
*.log
logs/

# ── Misc ─────────────────────────────────────────────────────
.cache/
.temp/
tmp/
