# ============================================================
# Backend Environment Variables — copy to .env and fill values
# For Render deployment, set these in the Render dashboard.
# ============================================================

PROJECT_NAME="Kadhiri AI Public Grievance Backend"
API_V1_STR="/api/v1"

# Generate a strong secret: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY="replace_me_with_a_strong_secret_key"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── Database ─────────────────────────────────────────────────
# Local PostgreSQL:
#   DATABASE_URL="postgresql://postgres:password@localhost:5432/kadhiri_grievance"
# Neon DB (cloud) — copy the connection string from neon.tech dashboard:
#   DATABASE_URL="postgresql://user:password@ep-xxx.ap-southeast-1.aws.neon.tech/kadhiri_grievance?sslmode=require"
DATABASE_URL="postgresql://user:password@host:5432/kadhiri_grievance"

# ── Redis (OPTIONAL — not required for core functionality) ───
# Leave blank or remove when deploying to Render free tier.
# REDIS_URL="redis://localhost:6379/0"

# ── OpenAI ───────────────────────────────────────────────────
# Get from https://platform.openai.com/api-keys
OPENAI_API_KEY="sk-proj-..."

# ── File storage directories ─────────────────────────────────
UPLOAD_TEMP_DIRECTORY="./temp_audio"
CSV_DIRECTORY="./csv_exports"
