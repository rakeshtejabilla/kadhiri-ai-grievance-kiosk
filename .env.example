# ============================================================
# Backend Environment Variables — copy to .env and fill values
# ============================================================

PROJECT_NAME="Kadhiri AI Public Grievance Backend"
API_V1_STR="/api/v1"

# Generate a strong secret: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY="replace_me_with_a_strong_secret_key"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# PostgreSQL connection string (local or Neon cloud)
DATABASE_URL="postgresql://user:password@host:5432/kadhiri_grievance"

# Redis connection string (local or cloud)
REDIS_URL="redis://localhost:6379/0"

# OpenAI API key — get from https://platform.openai.com/api-keys
OPENAI_API_KEY="sk-proj-..."

# File storage directories
UPLOAD_TEMP_DIRECTORY="./temp_audio"
CSV_DIRECTORY="./csv_exports"
